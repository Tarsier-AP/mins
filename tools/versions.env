# Pinned toolchain versions. tools/build.sh and tools/fetch-sources.sh read
# this file; bumping a version here changes the release build hash.

FFMPEG_VERSION=9.0.2
LIBVMAF_VERSION=3.0.0
SVTAV1_VERSION=3.1.0
LIBAOM_VERSION=3.13.1
LIBWEBP_VERSION=1.6.0
GIFLIB_VERSION=5.2.2
LIBAVIF_VERSION=1.4.2
LIBJXL_VERSION=0.12.0
LIBHEIF_VERSION=1.23.7
LIBDE265_VERSION=1.0.16
LIBOPUS_VERSION=1.6.1
VISQOL_VERSION=3.3.3
# ViSQOL 3.3.3 targets Bazel 3.4.1. 5.4.1 is the last release that keeps the
# old WORKSPACE/proto semantics while shipping linux-arm64 and darwin-arm64
# binaries; build-visqol.sh applies a small patch that removes the unused
# TensorFlow/TFLite dependency and repairs dead upstream download URLs.
BAZEL_VERSION=5.4.1

# Source tarballs (used by fetch-sources.sh).
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz
LIBVMAF_URL=https://github.com/Netflix/vmaf/archive/refs/tags/v${LIBVMAF_VERSION}.tar.gz
SVTAV1_URL=https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v${SVTAV1_VERSION}/SVT-AV1-v${SVTAV1_VERSION}.tar.gz
LIBAOM_URL=https://aomedia.googlesource.com/aom/+archive/refs/tags/v${LIBAOM_VERSION}.tar.gz
LIBWEBP_URL=https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-${LIBWEBP_VERSION}.tar.gz
# anim_dump (libwebp's animation decoder) needs giflib at build time. Building
# it here keeps the tool independent of a distro shipping libgif.a.
GIFLIB_URL=https://downloads.sourceforge.net/project/giflib/giflib-5.x/giflib-${GIFLIB_VERSION}.tar.gz
# SourceForge occasionally throttles; Debian carries the identical orig tarball.
GIFLIB_FALLBACK_URL=https://deb.debian.org/debian/pool/main/g/giflib/giflib_${GIFLIB_VERSION}.orig.tar.gz
LIBAVIF_URL=https://github.com/AOMediaCodec/libavif/archive/refs/tags/v${LIBAVIF_VERSION}.tar.gz
LIBJXL_URL=https://github.com/libjxl/libjxl/archive/refs/tags/v${LIBJXL_VERSION}.tar.gz
LIBHEIF_URL=https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz
LIBDE265_URL=https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz
LIBOPUS_URL=https://downloads.xiph.org/releases/opus/opus-${LIBOPUS_VERSION}.tar.gz
VISQOL_URL=https://github.com/google/visqol/archive/refs/tags/v${VISQOL_VERSION}.tar.gz
