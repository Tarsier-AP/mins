diff -Naur a/imageio/image_enc.c b/imageio/image_enc.c
--- a/imageio/image_enc.c	2026-11-18 02:06:54.530151452 +0300
+++ b/imageio/image_enc.c	2026-11-18 02:06:54.543751046 +0300
@@ -13,6 +13,7 @@
 
 #include <assert.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 
 #ifdef WEBP_HAVE_PNG
@@ -148,13 +149,41 @@
                  const WebPDecBuffer* const buffer) {
   const uint32_t width = buffer->width;
   const uint32_t height = buffer->height;
-  uint8_t* const rgb = buffer->u.RGBA.rgba;
+  uint8_t* rgb = buffer->u.RGBA.rgba;
   const int stride = buffer->u.RGBA.stride;
   const int has_alpha = WebPIsAlphaMode(buffer->colorspace);
-
-  return SUCCEEDED(WriteUsingWIC(out_file_name, use_stdout,
-                                 MAKE_REFGUID(GUID_ContainerFormatPng),
-                                 rgb, stride, width, height, has_alpha));
+  int ok;
+  // WIC's PNG encoder substitutes unsupported pixel formats silently
+  // (SetPixelFormat() is [in, out] and returns the closest supported one),
+  // and its BGR-family formats are the ones it reliably honors. Buffers
+  // decoded in RGB order (e.g. anim_dump's MODE_RGBA canvas) must be
+  // channel-swapped into BGR order here, or the PNG comes out with its red
+  // and blue channels swapped.
+  const int is_bgr = (buffer->colorspace == MODE_BGR ||
+                      buffer->colorspace == MODE_BGRA ||
+                      buffer->colorspace == MODE_bgrA);
+  if (!is_bgr) {
+    const uint32_t bpp = has_alpha ? 4 : 3;
+    uint32_t x, y;
+    uint8_t* bgr = (uint8_t*)malloc((size_t)stride * height);
+    if (bgr == NULL) return 0;
+    for (y = 0; y < height; ++y) {
+      const uint8_t* src = rgb + (size_t)y * stride;
+      uint8_t* dst = bgr + (size_t)y * stride;
+      for (x = 0; x < width; ++x) {
+        dst[x * bpp + 0] = src[x * bpp + 2];
+        dst[x * bpp + 1] = src[x * bpp + 1];
+        dst[x * bpp + 2] = src[x * bpp + 0];
+        if (bpp == 4) dst[x * bpp + 3] = src[x * bpp + 3];
+      }
+    }
+    rgb = bgr;
+  }
+  ok = SUCCEEDED(WriteUsingWIC(out_file_name, use_stdout,
+                               MAKE_REFGUID(GUID_ContainerFormatPng),
+                               rgb, stride, width, height, has_alpha));
+  if (rgb != buffer->u.RGBA.rgba) free(rgb);
+  return ok;
 }
 
 #elif defined(WEBP_HAVE_PNG)    // !HAVE_WINCODEC_H
